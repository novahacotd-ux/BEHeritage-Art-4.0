{
  "info": {
    "name": "HA4 Experience Posts API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection for testing experience post APIs including user create flow and admin review flow."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "periodId",
      "value": ""
    },
    {
      "key": "regionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public APIs",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/experience-posts?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has success=true', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Post By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/experience-posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts",
                "{{postId}}"
              ]
            }
          }
        },
        {
          "name": "Get Posts By User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/experience-posts/user/{{userId}}?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts",
                "user",
                "{{userId}}"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "User APIs",
      "item": [
        {
          "name": "Create Post (status auto pending)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "caption",
                  "value": "Bai viet trai nghiem moi",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "image",
                  "type": "text"
                },
                {
                  "key": "period_id",
                  "value": "{{periodId}}",
                  "type": "text"
                },
                {
                  "key": "region_id",
                  "value": "{{regionId}}",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/experience-posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Created post has pending status and save postId', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.status).to.eql('pending');",
                  "  pm.collectionVariables.set('postId', json.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "caption",
                  "value": "Cap nhat noi dung bai viet",
                  "type": "text"
                },
                {
                  "key": "period_id",
                  "value": "{{periodId}}",
                  "type": "text"
                },
                {
                  "key": "region_id",
                  "value": "{{regionId}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/experience-posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts",
                "{{postId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/experience-posts/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts",
                "{{postId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin APIs",
      "item": [
        {
          "name": "Review Post - Approve",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/experience-posts/{{postId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts",
                "{{postId}}",
                "review"
              ]
            }
          }
        },
        {
          "name": "Review Post - Reject",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"rejected\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/experience-posts/{{postId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "experience-posts",
                "{{postId}}",
                "review"
              ]
            }
          }
        }
      ]
    }
  ]
}
